# GROQ_API_KEY: High-speed LLM review suggestion & business insights generation (Groq Llama 3.3).
GROQ_API_KEY=""

# GEMINI_API_KEY: Optional secondary AI provider
GEMINI_API_KEY=""

# Admin allowlist: Comma-separated list of emails authorized for super-admin privileges
ADMIN_EMAILS="admin@authenticreviews.com,nimishbordiyajain@gmail.com"

# Optional: Firebase Admin Service Account Key JSON (for production serverless custom claims)
# If omitted, Firebase Admin will use project default credentials or fallback gracefully
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Optional: Upstash Redis / Vercel KV for persistent distributed rate limiting
# If omitted, rate limiting uses Firestore persistence
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# APP_URL: The URL where this applet is hosted (optional in local dev).
APP_URL="http://localhost:3000"

# Optional: Firebase Client Environment Variables (for custom hosting / Vercel deployment)
# If left blank, the app will read from firebase-applet-config.json
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
