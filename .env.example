# GEMINI_API_KEY: Required for server-side Gemini AI review draft generation.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted (optional in local dev).
APP_URL="http://localhost:3000"

# Optional: Firebase Client Environment Variables (for custom hosting / Vercel deployment)
# If left blank, the app will read from firebase-applet-config.json
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
